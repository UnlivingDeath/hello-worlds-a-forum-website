<% if (report.status === 'open') { %><form action="/reports/<%= report._id %>/respond" method="POST"><textarea name="response" maxlength="2000" placeholder="Response to reporter"></textarea><select name="decision"><option value="keep">keep post</option><option value="remove">remove post</option></select><button class="btn btn-small">respond</button></form><% } else { %><p><%= report.status %>: <%= report.response %></p><% } %>
