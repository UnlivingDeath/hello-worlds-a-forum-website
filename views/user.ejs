<%- include('partials/header', { title: profile.username + ' - profile', query: '' }) %>
<div class="container profile-page">
  <h1><%= profile.role === 'creator' ? '[creator] ' : profile.role === 'admin' ? '[admin] ' : '' %><%= profile.username %></h1>
  <p>AI information gathering: <strong><%= visibility.allowAiGathering ? 'allowed' : 'not allowed' %></strong></p>
  <% if (isOwner) { %><details><summary>edit page</summary><form action="/users/<%= profile._id %>/settings" method="POST">
    <% [['postsCreated','show posts created'],['postsUpvoted','show posts upvoted'],['comments','show comments'],['allowComments','allow profile comments'],['allowAiGathering','allow AI to gather information about me']].forEach(function(pair) { %><label class="field"><input type="checkbox" name="<%= pair[0] %>" <%= visibility[pair[0]] ? 'checked' : '' %>> <%= pair[1] %></label><% }) %>
    <button class="btn">save settings</button></form></details><% } %>
  <% if (visibility.postsCreated || isOwner) { %><section><h2>posts created</h2><% if (!created.length) { %><p>None shown.</p><% } %><% created.forEach(p => { %><article><a href="/posts/<%= p._id %>"><%= p.title %></a></article><% }) %></section><% } %>
  <% if (visibility.postsUpvoted || isOwner) { %><section><h2>posts upvoted</h2><% if (!upvoted.length) { %><p>None shown.</p><% } %><% upvoted.forEach(p => { %><article><a href="/posts/<%= p._id %>"><%= p.title %></a></article><% }) %></section><% } %>
  <% if (visibility.comments || isOwner) { %><section><h2>comments</h2><% if (!comments.length && !profileCommentsLeft.length) { %><p>None shown.</p><% } %><% comments.forEach(c => { %><article><a href="/posts/<%= c.post?._id %>#comment-<%= c._id %>"><%= c.post?.title || 'post unavailable' %></a><p><%= c.body %></p></article><% }) %><% profileCommentsLeft.forEach(c => { %><article>on <a href="/users/<%= c.profile?._id %>#profile-comments"><%= c.profile?.username || 'a profile' %>'s page</a><p><%= c.body %></p></article><% }) %></section><% } %>
  <% if (visibility.allowComments || isOwner) { %><section id="profile-comments"><h2>profile comments</h2><% profileComments.forEach(c => { %><article><a href="/users/<%= c.author %>"><%= c.authorRole === 'creator' ? '[creator] ' : c.authorRole === 'admin' ? '[admin] ' : '' %>@<%= c.authorName %></a> · <%= new Date(c.createdAt).toLocaleString() %><p><%= c.body %></p></article><% }) %>
    <% if (user) { %><form action="/users/<%= profile._id %>/comments" method="POST"><label for="profile-comment">leave a comment</label><textarea id="profile-comment" name="body" maxlength="2000" required></textarea><button class="btn">comment</button></form><% } else { %><p><a href="/login">Log in</a> to comment.</p><% } %></section><% } %>
</div><%- include('partials/footer') %>
