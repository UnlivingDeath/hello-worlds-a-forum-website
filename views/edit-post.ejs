<%- include('partials/header', { title: 'Edit post — hello worlds', query: '', editor: true }) %>

<div class="container">
  <h1>Edit thread</h1>
  <form class="form form-wide" action="/posts/<%= post._id %>/edit" method="POST">
    <div class="field">
      <label for="title"><i class="bi bi-text-left"></i> title</label>
      <input id="title" name="title" maxlength="140" value="<%= post.title %>" required />
    </div>
    <div class="field">
      <label for="body"><i class="bi bi-body-text"></i> post</label>
      <textarea id="body" name="body" rows="10" data-markdown><%= post.body %></textarea>
    </div>

    <div class="field">
      <label for="tag-select"><i class="bi bi-tags-fill"></i> tags</label>
      <select id="tag-select" class="tag-dropdown-summary">
        <option value="">choose a tag…</option>
        <% availableTags.forEach(function(t) { %>
          <option value="<%= t %>">#<%= t %></option>
        <% }) %>
      </select>
      <div id="tag-box" class="tag-box"></div>
      <input type="hidden" id="tags" name="tags" value="<%= tagsInput %>" />
    </div>

    <% if (error) { %>
      <p class="error-text"><%= error %></p>
    <% } %>
    <button class="btn" type="submit"><i class="bi bi-floppy2-fill"></i> save</button>
  </form>
</div>

<script>
  const select = document.getElementById('tag-select');
  const box = document.getElementById('tag-box');
  const hiddenInput = document.getElementById('tags');
  let selected = hiddenInput.value ? hiddenInput.value.split(',').filter(Boolean) : [];

  function render() {
    box.innerHTML = '';
    selected.forEach((tag) => {
      const chip = document.createElement('span');
      chip.className = 'tag-chip';
      chip.textContent = tag;
      const del = document.createElement('button');
      del.type = 'button';
      del.className = 'tag-chip-remove';
      del.textContent = '×';
      del.addEventListener('click', () => {
        selected = selected.filter((t) => t !== tag);
        render();
      });
      chip.appendChild(del);
      box.appendChild(chip);
    });
    hiddenInput.value = selected.join(',');
  }

  select.addEventListener('change', () => {
    const value = select.value;
    if (value && !selected.includes(value)) {
      selected.push(value);
      render();
    }
    select.value = '';
  });

  render();
</script>
<script src="https://cdn.jsdelivr.net/npm/easymde@2.18.0/dist/easymde.min.js"></script>
<script src="/js/editor.js"></script>
<%- include('partials/footer') %>