<%- include('partials/header', { title: 'Admin report log', query: '' }) %>
<div class="container"><h1>Admin report log</h1><nav>sort: <a href="?sort=recent">recent</a> · <a href="?sort=user">user</a> · <a href="?sort=post">post</a></nav>
<% if (sort === 'recent') { reports.forEach(r => { %><details open><summary>@<%= r.reporterName %> reported <%= r.postTitle %> · <%= new Date(r.createdAt).toLocaleString() %></summary><p><%= r.reason %></p><%- include('partials/report-response', { report: r }) %></details><% }) } else { const groups = {}; reports.forEach(r => { const key = sort === 'user' ? r.reporterName : r.postTitle; (groups[key] ||= []).push(r); }); Object.entries(groups).forEach(([key, items]) => { %><details><summary><%= key %> (<%= items.length %>)</summary><% items.forEach(r => { %><article><p><%= r.postTitle %> · @<%= r.reporterName %>: <%= r.reason %></p><%- include('partials/report-response', { report: r }) %></article><% }) %></details><% }) } %>
</div><%- include('partials/footer') %>
