<%- include('partials/header', { title: post.title + ' — hello worlds', query: '' }) %>
<% const myVote = user ? post.votes.find(function(v) { return v.user.toString() === user.id; }) : null; %>


<div class="post-layout">
 <div class="vote-widget">
  <% if (user) { %>
    <form action="/posts/<%= post._id %>/vote" method="POST" class="vote-form">
      <input type="hidden" name="value" value="1" />
      <button type="submit" class="vote-btn <%= myVote && myVote.value === 1 ? 'active' : '' %>">+</button>
    </form>
  <% } %>
  <span class="vote-score"><%= post.score %></span>
  <% if (user) { %>
    <form action="/posts/<%= post._id %>/vote" method="POST" class="vote-form">
      <input type="hidden" name="value" value="-1" />
      <button type="submit" class="vote-btn <%= myVote && myVote.value === -1 ? 'active' : '' %>">-</button>
    </form>
  <% } %>
</div>
<div class="container post-detail">
 
  <h2><%= post.title %></h2>
  <div class="post-meta">
    <%= post.authorName %> · <%= new Date(post.createdAt).toLocaleString() %>
  </div>
  <% if (post.tags && post.tags.length) { %>
    <div class="tag-list">
      <% post.tags.forEach(function(t) { %>
        <a class="tag-pill" href="/search?tag=<%= encodeURIComponent(t) %>">#<%= t %></a>
      <% }) %>
    </div>
  <% } %>
  <p class="post-body"><%= post.body %></p>

  <div class="comments-section">
    <h2><%= comments.length %> comment<%= comments.length === 1 ? '' : 's' %></h2>

    <% comments.forEach(function(c) { %>
      <div class="comment">
        <div class="comment-meta">
          <%= c.authorName %> · <%= new Date(c.createdAt).toLocaleString() %>
        </div>
        <div><%= c.body %></div>
      </div>
    <% }) %>

    <% if (user) { %>
      <form class="comment-form" action="/posts/<%= post._id %>/comments" method="POST" style="margin-top: 1.5rem;">
        <div class="field">
          <label for="body">Add a comment</label>
          <textarea id="body" name="body" rows="3" required></textarea>
        </div>
        <% if (error) { %>
          <p class="error-text"><%= error %></p>
        <% } %>
        <button class="btn" type="submit">Post comment</button>
      </form>
    <% } else { %>
      <p class="helper-text"><a href="/login">Log in</a> to join the discussion.</p>
    <% } %>
  </div>
</div>
</div>
<%- include('partials/footer') %>
