<%- include('partials/header', { title: 'hello worlds', query: query, activeTags: activeTags, activeSort: activeSort }) %>
<div class="home-layout">

  <aside class="intro-panel"><div class="window-title-bar"><span>introduction</span><div><span style=" padding: 4px 6px; margin-left: 4px; background: #c0c0c0; color: black; cursor: pointer;">_</span><span style=" padding: 4px 6px; margin-left: 4px; background: #c0c0c0; color: black; cursor: pointer;">□</span><span style=" padding: 4px 6px; margin-left: 4px; background: #c0c0c0; color: black; cursor: pointer;">X</span></div></div><div class="window-contents">
    <h2>welcome to &lthello worlds!&gt</h2>
    <p>a place where we ask and answer anything related to code. there are <%= posts.length %> posts in total for you to check out.</p><br>
    <% if (!user) { %>
          <p>make yourself an account to engage in our community.</p>
          <a href="/login">log in</a>
          <br>
          <a href="/register">sign up</a>
    <% } %>
    <a href="/about">about</a>
  </div></aside>
<div class="container">

  <div class="page-heading">
    <% if (query || (activeTags && activeTags.length)) { %>
      <h2>
        >> searching: 
        <% if (activeTags && activeTags.length) { %>
          <% activeTags.forEach(function(t, i) { %>#<%= t %><%= i < activeTags.length - 1 ? ', ' : '' %><% }) %>
        <% } %>
        <% if (query && activeTags && activeTags.length) { %> > <% } %>
        <% if (query) { %>“<%= query %>”<% } %>
      </h2>
    <% } else { %>
      <% if (activeSort == "votes") {%>
        <h2>most voted posts</h2>
      <% } %>
      <% if (activeSort == "latest") {%>
        <h2>latest posts</h2>
      <% } %>
      <% if (activeSort == "active") {%>
        <h2>last active posts</h2>
      <% } %>
    <% } %>
  </div>
  <% if (posts.length === 0) { %>
    <p class="empty-state">
      <% if (query || activeTags) { %>No posts match that search.<% } else { %>No posts yet. Be the first to start a thread.<% } %>
    </p>
  <% } %>

  <% posts.forEach(function(post) { %>
    <article class="post-card">
      
      <h2><a href="/posts/<%= post._id %>"><%= post.title %> </a></h2>
      <h3>by @<%= post.authorName %></h3>

      <% const myVote = user ? post.votes.find(function(v) { return v.user.toString() === user.id; }) : null; %>
      <div class="vote-widget">
        <% if (user) { %>
          <form action="/posts/<%= post._id %>/vote" method="POST" class="vote-form">
            <input type="hidden" name="value" value="1" />
            <button type="submit" class="vote-btn <%= myVote && myVote.value === 1 ? 'active' : '' %>">+</button>
          </form>
        <% } %>
        <span class="vote-score"><%= post.score %> <% if (!user) {%>upvotes<% } %></span>
        <% if (user) { %>
          <form action="/posts/<%= post._id %>/vote" method="POST" class="vote-form">
            <input type="hidden" name="value" value="-1" />
            <button type="submit" class="vote-btn <%= myVote && myVote.value === -1 ? 'active' : '' %>">-</button>
          </form>
        <% } %>
      </div>


      <br>
      <p class="post-excerpt">
        <!-- <%= post.body.length > 160 ? post.body.slice(0, 160).trim() + '…' : post.body %> -->
         <%= excerpt(post.body, 160) %>
      </p>

      
        <div class="post-meta">
      <div class="tag-list">

        <% if (post.tags && post.tags.length) { %>
          <% post.tags.forEach(function(t) { %>
            <a class="tag-pill" href="/search?tag=<%= encodeURIComponent(t) %>"><i class="bi bi-tags-fill"></i> <%= t %></a>
          <% }) %>        
        <% } else {%>
          <p>this post has no <i class="bi bi-tags-fill"></i> tags.</p>
        <% }%>

      </div>

      <div class="other-metas">

          <i class="bi bi-calendar-event-fill"></i> <%= new Date(post.createdAt).toDateString() %><br>
        <i class="bi bi-chat-left-quote-fill"></i> <%= post.commentCount %>
          <% if (post.editedAt) { %> · <span class="edited-tag">edited</span><% } %>

      </div>
      </div>
    </article>
  <% }) %>
</div>
  <aside class="side-panel-right"><div class="window-title-bar"><span>notifications<% if (unreadCount > 0) { %> <span class="notif-badge"><%= unreadCount %></span><% } %></span><div><span style=" padding: 4px 6px; margin-left: 4px; background: #c0c0c0; color: black; cursor: pointer;">_</span><span style=" padding: 4px 6px; margin-left: 4px; background: #c0c0c0; color: black; cursor: pointer;">□</span><span style=" padding: 4px 6px; margin-left: 4px; background: #c0c0c0; color: black; cursor: pointer;">X</span></div></div><div class="window-contents">
  <% if (!user) { %>
    <p class="notif-empty">log in to see your notifications.</p>
  <% } else if (notifications.length === 0) { %>
    <p class="notif-empty">you got mail! (well, not yet - nothing here.)</p>
  <% } else { %>
    <% if (unreadCount > 0) { %>
      <form action="/notifications/read-all" method="POST" style="margin-bottom:0.5rem;">
        <button type="submit" class="notif-mark-all-btn">mark all as read</button>
      </form>
    <% } %>
    <ul class="notif-list">
      <% notifications.forEach(function(n) { %>
        <li class="notif-item<%= n.read ? '' : ' notif-unread' %>">
          <form action="/notifications/<%= n._id %>/read" method="POST" style="margin:0;">
            <button type="submit" class="notif-link-btn" title="<%= n.message %>">
              <span class="notif-icon">
                <% if (n.type === 'comment') { %><i class="bi bi-chat-left-quote-fill"></i>
                <% } else { %><i class="bi bi-arrow-up-circle-fill"></i><% } %>
              </span>
              <span class="notif-text"><%= n.message %></span>
              <% if (!n.read) { %><span class="notif-dot"></span><% } %>
            </button>
          </form>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div></aside>
</div>

<%- include('partials/footer') %>
