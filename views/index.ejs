<%- include('partials/header', { title: 'hello worlds', query: query, activeTags: activeTags, activeUsers: activeUsers, activeSort: activeSort }) %>
<div class="home-layout">

  <aside class="intro-panel"><details open><summary class="window-title-bar">introduction<div class="code-runner-window-controls" aria-hidden="true"><span>_</span><span>□</span><span>X</span></div></summary><div class="window-contents">
    <h2>welcome to &lthello worlds!&gt</h2>
    <p>a place where we ask and answer anything related to code. there are <%= posts.length %> posts in total for you to check out.</p><br>
    <% if (!user) { %>
          <p>make yourself an account to engage in our community.</p>
          <a href="/login">log in</a>
          <br>
          <a href="/register">sign up</a>
    <% } %>
  </div></details>
  <section class="trending-panel"><details open>
    <summary class="window-title-bar">trending<div class="code-runner-window-controls" aria-hidden="true"><span>_</span><span>□</span><span>X</span></div></summary>
    <div class="trending-scroll window-contents" data-show-more-group data-initial-count="10" data-batch-size="10">
      <% (trendingPosts || []).forEach(function(post) { %>
        <article class="trending-card" data-show-more-item>
          <span class="post-type-badge"><%= post.postType %></span>
          <h3><a href="/posts/<%= post._id %>"><%= post.title %></a></h3>
          <p>↑ <%= post.score %> · <%= post.commentCount %> comments</p>
          <small>by <a href="/users/<%= post.author %>"><%= post.authorRole === 'creator' ? '[creator] ' : post.authorRole === 'admin' ? '[admin] ' : '' %>@<%= post.authorName %></a></small>
        </article>
      <% }) %>
      <% if (trendingPosts && trendingPosts.length > 10) { %><button type="button" class="btn show-more-btn" data-show-more>show more trending posts</button><% } %>
    </div></details>
  </section>
</aside>
<div class="container" data-show-more-group data-initial-count="5" data-batch-size="5">

  <div class="page-heading">
    <% const userFilter = typeof activeUsers !== 'undefined' ? activeUsers.trim() : ''; %>
    <% if (query || (activeTags && activeTags.length) || userFilter) { %>
      <h2>
        >> searching: 
        <% if (activeTags && activeTags.length) { %>
          <% activeTags.forEach(function(t, i) { %>#<%= t %><%= i < activeTags.length - 1 ? ', ' : '' %><% }) %>
        <% } %>
        <% if (query && activeTags && activeTags.length) { %> > <% } %>
        <% if (query) { %>“<%= query %>”<% } %>
        <% if (userFilter && (query || (activeTags && activeTags.length))) { %> > <% } %>
        <% if (userFilter) { %>users: <%= userFilter %><% } %>
      </h2>
    <% } else { %>
      <% if (activeSort == "votes") {%>
        <h2>most voted posts</h2>
      <% } %>
      <% if (activeSort == "latest") {%>
        <h2>latest posts</h2>
      <% } %>
      <% if (activeSort == "active") {%>
        <h2>last active posts</h2>
      <% } %>
    <% } %>
  </div>
  <% if (posts.length === 0) { %>
    <p class="empty-state">
      <% if (query || activeTags) { %>no posts match that search.<% } else { %>no posts yet. be the first to start a thread.<% } %>
    </p>
  <% } %>

  <% posts.forEach(function(post) { %>
    <article class="post-card" data-show-more-item>
      <span class="post-type-badge"><%= post.postType %></span>
      
      <h2><a href="/posts/<%= post._id %>"><%= post.title %> </a></h2>
      <h3>by <a href="/users/<%= post.author %>"><%= post.authorRole === 'creator' ? '[creator] ' : post.authorRole === 'admin' ? '[admin] ' : '' %>@<%= post.authorName %></a></h3>

      <% const myVote = user ? post.votes.find(function(v) { return v.user.toString() === user.id; }) : null; %>
      <div class="vote-widget">
        <% if (user) { %>
          <form action="/posts/<%= post._id %>/vote" method="POST" class="vote-form">
            <input type="hidden" name="value" value="1" />
            <button type="submit" class="vote-btn <%= myVote && myVote.value === 1 ? 'active' : '' %>">+</button>
          </form>
        <% } %>
        <span class="vote-score"><%= post.score %> <% if (!user) {%>upvotes<% } %></span>
        <% if (user) { %>
          <form action="/posts/<%= post._id %>/vote" method="POST" class="vote-form">
            <input type="hidden" name="value" value="-1" />
            <button type="submit" class="vote-btn <%= myVote && myVote.value === -1 ? 'active' : '' %>">-</button>
          </form>
        <% } %>
      </div>


      <br>
      <p class="post-excerpt">
        <!-- <%= post.body.length > 160 ? post.body.slice(0, 160).trim() + '…' : post.body %> -->
         <%= excerpt(post.body, 160) %>
      </p>

      
        <div class="post-meta">
      <div class="tag-list">

        <% const specialPostTags = [...(post.isPinned ? ['pinned'] : []), ...(post.isMain ? ['main'] : []), ...(post.postType === 'question' ? [`${post.questionState || 'unsolved'}-question`] : [])]; %>
        <% if ((post.tags && post.tags.length) || specialPostTags.length) { %>
          <% specialPostTags.forEach(function(t) { %><a class="tag-pill special-tag" href="/search?tag=<%= encodeURIComponent(t) %>"><i class="bi bi-asterisk"></i> <%= tagLabel(t) %></a><% }) %>
          <% post.tags.forEach(function(t) { %>
            <a class="tag-pill" href="/search?tag=<%= encodeURIComponent(t) %>"><i class="bi bi-tags-fill"></i> <%= tagLabel(t) %></a>
          <% }) %>        
        <% } else {%>
          <p>this post has no <i class="bi bi-tags-fill"></i> tags.</p>
        <% }%>

      </div>

      <div class="other-metas">

          <i class="bi bi-calendar-event-fill"></i> <%= new Date(post.createdAt).toDateString() %><br>
        <i class="bi bi-chat-left-quote-fill"></i> <%= post.commentCount %>
          <% if (post.editedAt) { %> · <span class="edited-tag">edited</span><% } %>

      </div>
      </div>
      <% if (user) { %>
      <div class="post-card-actions">
        <% if (user && (post.author.toString() === user.id || ['admin','creator'].includes(user.role))) { %>
          <div class="post-owner-actions">
            <a class="btn btn-small edit-and-del-buttons" href="/posts/<%= post._id %>/edit" style="align-content: center;"><i class="bi bi-pen"></i> edit</a>
            <form class="delete-align" action="/posts/<%= post._id %>/delete" method="POST" onsubmit="return confirm('Delete this post? This cannot be undone.');">
              <button type="submit" class="btn btn-small edit-and-del-buttons"><i class="bi bi-trash"></i> delete</button>
            </form>
          </div>
        <% } %>
        <% if (user && post.author.toString() !== user.id) { %>
          <details class="report-panel">
            <summary>report</summary>
            <form class="report-form" action="/posts/<%= post._id %>/report" method="POST">
              <textarea name="reason" required maxlength="2000" placeholder="Why are you reporting this post?"></textarea>
              <button type="submit" class="btn btn-small">send report</button>
            </form>
          </details>
        <% } %>
      </div>
      <% } %>
    </article>
  <% }) %>
  <% if (posts.length > 5) { %>
    <button type="button" class="btn show-more-btn" data-show-more>show more posts</button>
  <% } %>
</div>
  <aside class="side-panel-right"><details open><summary class="window-title-bar">notifications<div class="code-runner-window-controls" aria-hidden="true"><span>_</span><span>□</span><span>X</span></div><% if (unreadCount > 0) { %> <% } %></summary><div class="window-contents">
  <% if (!user) { %>
    <p class="notif-empty">log in to see your notifications.</p>
  <% } else if (notifications.length === 0) { %>
    <p class="notif-empty">you got mail! (well, not yet - nothing here.)</p>
    <a href="/notifications">show all notifications</a>

  <% } else { %>
    <% if (unreadCount > 0) { %>
      <form action="/notifications/read-all" method="POST" style="margin-bottom:0.5rem;">
        <button type="submit" class="notif-mark-all-btn">mark all as read</button>
      </form>
    <% } %>
    <form action="/notifications/clear-all" method="POST" onsubmit="return confirm('Clear all notifications?');"><button class="notif-mark-all-btn">clear all</button></form>
    <ul class="notif-list">
      <% notifications.forEach(function(n) { %>
        <li class="notif-item<%= n.read ? '' : ' notif-unread' %>">
          <% if (n.type === 'report_response') { %><div class="notif-link-btn notif-response-text"><span class="notif-icon"><i class="bi bi-shield-check"></i></span><span class="notif-text"><%= n.message %></span></div><% } else { %><form action="/notifications/<%= n._id %>/read" method="POST" style="margin:0;">
            <button type="submit" class="notif-link-btn" title="<%= n.message %>">
              <span class="notif-icon">
                <% if (n.type === 'comment' || n.type === 'profile_comment') { %><i class="bi bi-chat-left-quote-fill"></i>
                <% } else if (n.type === 'report_response') { %><i class="bi bi-shield-check"></i>
                <% } else { %><i class="bi bi-arrow-up-circle-fill"></i><% } %>
              </span>
              <span class="notif-text"><%= n.message %></span>
              <% if (!n.read) { %><% } %>
            </button>
          </form><% } %>
        </li>
      <% }) %>
    </ul>
    <a href="/notifications">show all notifications</a>
  <% } %>
</div></details>
  <% if (user && ['admin','creator'].includes(user.role)) { %>
    <details class="admin-log" open><summary class="window-title-bar">admin report log<div class="code-runner-window-controls" aria-hidden="true"><span>_</span><span>□</span><span>X</span></div></summary><div class="window-contents">
      <nav><a href="/admin/reports?sort=recent">recent</a> · <a href="/admin/reports?sort=user">by user</a> · <a href="/admin/reports?sort=post">by post</a></nav>
      <% (reports || []).forEach(function(report) { %>
        <details class="report-item" open>
          <summary>@<%= report.reporterName %> · <%= report.postTitle %></summary>
          <p><%= report.reason %></p>
          <%- include('partials/report-response', { report: report }) %>
        </details>
      <% }) %>
        <% if (!reports || !reports.length) { %>
          <p class="notif-empty">no open reports</p>
        <% } %>
      <a href="/admin/reports">show all reports</a>
    </div></details>
  <% } %>
  </aside>
</div>

<script src="/js/show-more.js"></script>
<%- include('partials/footer') %>
